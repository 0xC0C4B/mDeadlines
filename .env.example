# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# (Optional) Default Moodle Calendar iCal (.ics) URL
# Users can also configure their own calendar URL via /setmoodle <url>
DEFAULT_MOODLE_ICAL_URL=

# Background check interval in seconds (default is 1800 seconds = 30 minutes)
CHECK_INTERVAL_SECONDS=1800

# Hours before deadline when alerts should be triggered (comma separated)
# E.g. "48,24,3" sends warnings 48h, 24h, and 3h before the deadline
ALERT_HOURS_BEFORE=48,24,3

# Local timezone name (e.g., UTC, Europe/Berlin, America/New_York)
TIMEZONE=UTC
